{
  "expo": {
    "name": "Szlakowy",
    "slug": "moja-apka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mojaapka",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Szlakowy używa GPS, żeby nagrać Twoją trasę w górach."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Szlakowy liczy Twoje kroki na trasie."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Szlakowy potrzebuje dostępu do zdjęć, żebyś mógł ustawić zdjęcie profilowe."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}